{
  "name": "teams",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/unit/checklist-progress-and-validation.test.ts tests/unit/attachment-validation-and-urls.test.ts",
    "test:integration": "tsx --env-file-if-exists=.env.local --test tests/integration/checklist-database-and-actions.test.ts tests/integration/attachment-database-and-r2.test.ts",
    "test:all": "tsx --test tests/unit/checklist-progress-and-validation.test.ts tests/unit/attachment-validation-and-urls.test.ts && tsx --env-file-if-exists=.env.local --test tests/integration/checklist-database-and-actions.test.ts tests/integration/attachment-database-and-r2.test.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:smoke": "tsx --env-file-if-exists=.env.local scripts/check-database.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed-roles.ts",
    "db:provision-admin": "tsx --env-file-if-exists=.env.local scripts/provision-admin.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@clerk/nextjs": "^7.5.19",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "prisma": "^7.8.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
