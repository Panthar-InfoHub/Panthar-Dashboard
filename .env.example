# ─────────────────────────────────────────────────────────────
# Panthar Teams — Environment Variables Template
# Copy this file to .env.local and populate with actual credentials.
# NEVER commit .env.local or expose production secrets in source code.
# ─────────────────────────────────────────────────────────────

# ── Application Configuration ──
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Neon Serverless PostgreSQL ──
# DATABASE_URL: Neon pooled connection string used by the runtime application via @prisma/adapter-neon
DATABASE_URL=
# DIRECT_URL: Direct, non-pooled connection string used exclusively by Prisma CLI for migrations
DIRECT_URL=
# ── Clerk Authentication ──
# Obtain from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Clerk Webhook Signing Secret (from Clerk Dashboard -> Webhooks -> Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_placeholder

# ── Clerk Route Redirection Conventions ──
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ── Future Cloudflare R2 Storage (Optional for Ticket 2 - Task Attachments) ──
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_PUBLIC_URL=
